#include "resource.h"
#include <winver.h>

IDI_APP_ICON ICON "app.ico"

// ONAIR_VERSION_STR / ONAIR_VERSION_NUM come from latest-version.txt via the project file.
// rc.exe drops quoted /D values, so the version arrives bare and is stringized here.
#define ONAIR_STRINGIZE2(x) #x
#define ONAIR_STRINGIZE(x) ONAIR_STRINGIZE2(x)
VS_VERSION_INFO VERSIONINFO
 FILEVERSION ONAIR_VERSION_NUM
 PRODUCTVERSION ONAIR_VERSION_NUM
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Manggdy"
            VALUE "FileDescription", "OnAir"
            VALUE "FileVersion", ONAIR_STRINGIZE(ONAIR_VERSION_STR)
            VALUE "InternalName", "OnAir"
            VALUE "LegalCopyright", "Copyright (C) 2026 Manggdy"
            VALUE "OriginalFilename", "OnAir.exe"
            VALUE "ProductName", "OnAir"
            VALUE "ProductVersion", ONAIR_STRINGIZE(ONAIR_VERSION_STR)
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
