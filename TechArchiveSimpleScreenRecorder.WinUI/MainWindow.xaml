<Window
    x:Class="TechArchiveSimpleScreenRecorder.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Tech Archive Simple Screen Recorder">

    <Grid RequestedTheme="Light">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFF6F8FC" Offset="0" />
                <GradientStop Color="#FFF7F7FB" Offset="0.45" />
                <GradientStop Color="#FFFFF1F2" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Margin="24,16,24,0" Height="56">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="3">
                <TextBlock Text="Tech Archive Simple Screen Recorder"
                           FontSize="22"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI Variable Display Semib"
                           Foreground="{StaticResource AppTextBrush}" />
                <TextBlock Text="WinUI 3 front-end with native C++ capture core"
                           FontFamily="Segoe UI Variable Text"
                           Foreground="{StaticResource AppMutedBrush}" />
            </StackPanel>

            <Border Grid.Column="1"
                    Background="#F8FFFFFF"
                    CornerRadius="999"
                    Padding="16,8"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE768;"
                              FontFamily="Segoe Fluent Icons"
                              Foreground="{StaticResource AppAccentBrush}" />
                    <TextBlock Text="MP4 / H.264 / AAC"
                               Foreground="{StaticResource AppAccentBrush}"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24,18,24,24"
                  RowSpacing="18"
                  ColumnSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*" />
                    <ColumnDefinition Width="1.1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource CardBorderStyle}"
                        Background="{StaticResource AppCardStrongBrush}">
                    <Grid RowSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="12">
                            <TextBlock Text="Simple capture, cleaner desk."
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       FontFamily="Segoe UI Variable Display Semib"
                                       Foreground="{StaticResource AppTextBrush}" />
                            <TextBlock Text="Pick a save path, set the red frame, and record with system audio."
                                       MaxWidth="520"
                                       TextWrapping="Wrap"
                                       Foreground="#FF334155"
                                       FontSize="15"
                                       FontFamily="Segoe UI Variable Text" />

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Style="{StaticResource ChipBorderStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7C3;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource AppAccentBrush}" />
                                        <TextBlock Text="Resizable frame" Foreground="{StaticResource AppTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource ChipBorderStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE189;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource AppAccentBrush}" />
                                        <TextBlock Text="System audio" Foreground="{StaticResource AppTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource ChipBorderStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7B8;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource AppAccentBrush}" />
                                        <TextBlock Text="Native C++ core" Foreground="{StaticResource AppTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Row="1" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="10">
                                <TextBlock Text="OUTPUT" Style="{StaticResource SectionLabelStyle}" />
                                <TextBox x:Name="OutputPathTextBox"
                                         Height="50"
                                         PlaceholderText="save .mp4"
                                         FontSize="15"
                                         FontFamily="Segoe UI Variable Text"
                                         VerticalContentAlignment="Center"
                                         Background="#F9FFFFFF"
                                         BorderBrush="#140F172A"
                                         CornerRadius="18" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    x:Name="BrowseButton"
                                    Width="112"
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Click="BrowseButton_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                    <FontIcon Glyph="&#xE8B7;" FontFamily="Segoe Fluent Icons" />
                                    <TextBlock Text="Browse" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource CardBorderStyle}"
                        Background="#FF18212F">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="6">
                            <TextBlock Text="SESSION"
                                       Style="{StaticResource SectionLabelStyle}"
                                       Foreground="#99FFFFFF" />
                            <TextBlock x:Name="StatusTextBlock"
                                       Text="READY"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       FontFamily="Segoe UI Variable Display Semib"
                                       Foreground="White" />
                            <TextBlock x:Name="ElapsedTextBlock"
                                       Text="00:00"
                                       FontSize="15"
                                       Foreground="#B6C2D0" />
                        </StackPanel>

                        <Border Background="#14FFFFFF"
                                CornerRadius="22"
                                Padding="16">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Glyph="&#xE768;"
                                          FontFamily="Segoe Fluent Icons"
                                          Foreground="{StaticResource AppAccentBrush}"
                                          FontSize="18"
                                          VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="MP4 video with H.264 and AAC system audio."
                                           Foreground="#D7E0EA"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource AppAccentSoftBrush}"
                                CornerRadius="22"
                                Padding="16">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="UpdateStateTextBlock"
                                           Text="Updates ready"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AppAccentBrush}" />
                                <TextBlock Text="Installer and auto-update are wired through Velopack."
                                           Foreground="#FFFDECEC"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource CardBorderStyle}">
                    <Grid RowSpacing="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock Text="CAPTURE AREA"
                                           Style="{StaticResource SectionLabelStyle}" />
                                <TextBlock Text="Red frame overlay"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI Variable Display Semib"
                                           Foreground="{StaticResource AppTextBrush}" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Background="{StaticResource AppSurfaceBrush}"
                                    CornerRadius="20"
                                    Padding="16,10"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7C3;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource AppAccentBrush}" />
                                    <TextBlock x:Name="RegionTextBlock"
                                               Text="0 x 0"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AppTextBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Row="0"
                                    Grid.Column="0"
                                    x:Name="FrameButton"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Click="FrameButton_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                    <FontIcon Glyph="&#xE8C8;" FontFamily="Segoe Fluent Icons" />
                                    <TextBlock Text="Frame" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="0"
                                    Grid.Column="1"
                                    x:Name="FullButton"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Click="FullButton_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                    <FontIcon Glyph="&#xE740;" FontFamily="Segoe Fluent Icons" />
                                    <TextBlock Text="Full" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="1"
                                    Grid.Column="0"
                                    x:Name="RecordButton"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    Click="RecordButton_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontFamily="Segoe Fluent Icons" />
                                    <TextBlock Text="Record" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="1"
                                    Grid.Column="1"
                                    x:Name="StopButton"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Click="StopButton_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                    <FontIcon Glyph="&#xE71A;" FontFamily="Segoe Fluent Icons" />
                                    <TextBlock Text="Stop" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="AUDIO"
                                   Style="{StaticResource SectionLabelStyle}" />
                        <Border Background="{StaticResource AppSurfaceBrush}"
                                CornerRadius="22"
                                Padding="16">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE189;"
                                          FontFamily="Segoe Fluent Icons"
                                          Foreground="{StaticResource AppAccentBrush}"
                                          FontSize="18" />
                                <StackPanel Spacing="4">
                                    <TextBlock Text="System sound"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AppTextBrush}" />
                                    <TextBlock Text="Recorded directly with the video."
                                               Foreground="{StaticResource AppMutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource AppSurfaceBrush}"
                                CornerRadius="22"
                                Padding="16">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE7F4;"
                                          FontFamily="Segoe Fluent Icons"
                                          Foreground="{StaticResource AppAccentBrush}"
                                          FontSize="18" />
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Compact control surface"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AppTextBrush}" />
                                    <TextBlock Text="The recorder stays minimal while keeping the core actions visible."
                                               Foreground="{StaticResource AppMutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Style="{StaticResource CardBorderStyle}"
                        Background="#F5FFFFFF">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="MessageTextBlock"
                                   Text="Ready"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource AppMutedBrush}" />
                        <Border Grid.Column="1"
                                Background="{StaticResource AppSurfaceBrush}"
                                CornerRadius="999"
                                Padding="12,7"
                                VerticalAlignment="Center">
                            <TextBlock Text="Tech Archive"
                                       Foreground="{StaticResource AppMutedBrush}"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
