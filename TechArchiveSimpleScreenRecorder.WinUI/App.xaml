<Application
    x:Class="TechArchiveSimpleScreenRecorder.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="AppAccentColor">#FFE23D3D</Color>
            <Color x:Key="AppAccentStrongColor">#FFB91C1C</Color>
            <Color x:Key="AppAccentSoftColor">#26E23D3D</Color>
            <Color x:Key="AppSurfaceColor">#FFF7F8FC</Color>
            <Color x:Key="AppCardColor">#D9FFFFFF</Color>
            <Color x:Key="AppCardStrongColor">#F2FFFFFF</Color>
            <Color x:Key="AppMutedColor">#FF64748B</Color>
            <Color x:Key="AppTextColor">#FF0F172A</Color>

            <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}" />
            <SolidColorBrush x:Key="AppAccentStrongBrush" Color="{StaticResource AppAccentStrongColor}" />
            <SolidColorBrush x:Key="AppAccentSoftBrush" Color="{StaticResource AppAccentSoftColor}" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurfaceColor}" />
            <SolidColorBrush x:Key="AppCardBrush" Color="{StaticResource AppCardColor}" />
            <SolidColorBrush x:Key="AppCardStrongBrush" Color="{StaticResource AppCardStrongColor}" />
            <SolidColorBrush x:Key="AppMutedBrush" Color="{StaticResource AppMutedColor}" />
            <SolidColorBrush x:Key="AppTextBrush" Color="{StaticResource AppTextColor}" />

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource AppCardBrush}" />
                <Setter Property="CornerRadius" Value="28" />
                <Setter Property="Padding" Value="24" />
                <Setter Property="BorderBrush" Value="#140F172A" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AppAccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Padding" Value="18,0" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text Semibold" />
            </Style>

            <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
                <Setter Property="Padding" Value="18,0" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text Semibold" />
                <Setter Property="BorderBrush" Value="#120F172A" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="ChipBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="#F8FFFFFF" />
                <Setter Property="BorderBrush" Value="#14FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="999" />
                <Setter Property="Padding" Value="12,7" />
            </Style>

            <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource AppMutedBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text Semibold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
